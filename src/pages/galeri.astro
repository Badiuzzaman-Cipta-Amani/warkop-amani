---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageIntro from '../components/PageIntro.astro';
import Gallery from '../components/Gallery.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout title={`Galeri | ${site.name}`} description="Foto-foto makanan, minuman, dan suasana di Warkop Amani, Cisaat, Sukabumi.">
  <Header />
  <main>
    <PageIntro title="Galeri Amani" sticker="kopi">
      <p>Potret-potret kecil dari meja, dapur, dan obrolan di Warkop Amani. Klik fotonya buat lihat lebih besar.</p>
    </PageIntro>
    <Gallery full />
  </main>
  <Footer />
</Layout>
