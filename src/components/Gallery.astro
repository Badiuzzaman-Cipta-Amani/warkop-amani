---
import { Icon } from 'astro-icon/components';
import Sticker from './Sticker.astro';
import { gallery } from '../data/gallery';

interface Props {
  // The /galeri page shows every photo; the home page shows the latest eight.
  full?: boolean;
}
const { full = false } = Astro.props;
const photos = full ? gallery : gallery.slice(0, 8);
const tilts = ['-3deg', '2deg', '-1.5deg', '3.5deg', '-2.5deg', '1deg', '-4deg', '2.5deg'];
---

<section id="galeri" class:list={['relative bg-paper', full ? 'pt-14 pb-20 md:pb-28' : 'py-20 md:py-28']}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    {
      !full && (
        <div class="flex flex-wrap items-end justify-between gap-6">
          <div class="relative" data-pop>
            <Sticker kind="kerupuk" class="absolute -top-10 -left-6 w-14 rotate-12" data-pop="spin" style="--d:300ms" />
            <h2 class="sticker-text text-[clamp(2.3rem,5.5vw,4rem)]">Galeri Amani</h2>
            <p class="mt-3 max-w-lg text-lg text-ink/80">Potret-potret kecil dari meja, dapur, dan obrolan di Warkop Amani.</p>
          </div>
          <a href="/galeri" class="btn btn-ghost" data-pop style="--d:150ms">
            <Icon name="ri:gallery-line" class="h-5 w-5" aria-hidden="true" />
            Lihat semua foto
          </a>
        </div>
      )
    }

    <ul class:list={['grid grid-cols-2 gap-5 sm:grid-cols-3 sm:gap-7 lg:grid-cols-4', !full && 'mt-12']} data-pop-stagger>
      {
        photos.map((photo, i) => (
          <li data-pop>
            <figure
              class="rounded-md bg-white p-2 pb-1 shadow-[0_10px_24px_-10px_rgb(43_27_29_/_0.4)] rotate-(--tilt) transition-[rotate,scale] duration-200 hover:scale-[1.03] hover:rotate-0"
              style={`--tilt:${tilts[i % tilts.length]}`}
            >
              <button
                type="button"
                class="grid aspect-square w-full cursor-zoom-in place-items-center overflow-hidden rounded-sm bg-cream"
                data-gallery-open={i}
                aria-label={`Perbesar foto: ${photo.caption}`}
              >
                <img src={photo.src} alt={photo.alt} class="h-full w-full object-contain" loading="lazy" decoding="async" />
              </button>
              <figcaption class="font-display truncate px-1 py-1.5 text-center text-base leading-tight text-navy sm:text-lg">
                {photo.caption}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <p class="mt-6 flex flex-wrap items-center gap-2 text-ink/70" data-pop>
      Lebih banyak cerita ada di
      <a href="https://www.instagram.com/warkopamani" target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-bold text-navy hover:underline">
        <Icon name="ri:instagram-line" class="h-5 w-5" aria-hidden="true" />@warkopamani
      </a>
    </p>
  </div>

  <dialog
    data-gallery-dialog
    class="m-auto max-h-[92vh] max-w-[min(92vw,56rem)] overflow-visible bg-transparent p-0 backdrop:bg-ink/80 backdrop:backdrop-blur-sm"
    aria-label="Foto galeri"
  >
    <figure class="relative rounded-lg bg-white p-3 pb-2">
      <img data-gallery-img alt="" class="mx-auto max-h-[78vh] w-auto rounded" />
      <figcaption data-gallery-caption class="font-display pt-2 text-center text-xl text-navy"></figcaption>
      <form method="dialog">
        <button class="absolute -top-4 -right-4 grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-maroon text-paper shadow-[0_4px_0_var(--color-maroon-deep)]" aria-label="Tutup">
          <Icon name="ri:close-line" class="h-6 w-6" aria-hidden="true" />
        </button>
      </form>
      <button type="button" data-gallery-step="-1" class="absolute top-1/2 -left-5 grid h-11 w-11 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-paper text-navy shadow-md" aria-label="Foto sebelumnya">
        <Icon name="ri:arrow-left-s-line" class="h-7 w-7" aria-hidden="true" />
      </button>
      <button type="button" data-gallery-step="1" class="absolute top-1/2 -right-5 grid h-11 w-11 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-paper text-navy shadow-md" aria-label="Foto berikutnya">
        <Icon name="ri:arrow-right-s-line" class="h-7 w-7" aria-hidden="true" />
      </button>
    </figure>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-gallery-dialog]');
  const img = dialog?.querySelector<HTMLImageElement>('[data-gallery-img]');
  const caption = dialog?.querySelector<HTMLElement>('[data-gallery-caption]');
  const openers = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery-open]')];
  let index = 0;

  function show(i: number) {
    if (!img || !caption) return;
    index = (i + openers.length) % openers.length;
    const source = openers[index].querySelector('img')!;
    img.src = source.src;
    img.alt = source.alt;
    caption.textContent = openers[index].closest('figure')?.querySelector('figcaption')?.textContent?.trim() ?? '';
  }

  openers.forEach((btn, i) =>
    btn.addEventListener('click', () => {
      show(i);
      dialog?.showModal();
    }),
  );
  dialog?.querySelectorAll<HTMLElement>('[data-gallery-step]').forEach((btn) =>
    btn.addEventListener('click', () => show(index + Number(btn.dataset.galleryStep))),
  );
  dialog?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(index - 1);
    if (e.key === 'ArrowRight') show(index + 1);
  });
  // Clicking the dimmed backdrop closes it too.
  dialog?.addEventListener('click', (e) => e.target === dialog && dialog.close());
</script>
