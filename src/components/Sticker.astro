---
// Small food illustrations, cut out like the stickers on Warkop Amani posts.
export type StickerKind =
  | 'dimsum'
  | 'chopsticks'
  | 'kopi'
  | 'egg'
  | 'matcha'
  | 'bowl'
  | 'esteh'
  | 'gorengan'
  | 'rotibakar'
  | 'pisang'
  | 'kopisaset'
  | 'kerupuk'
  | 'mie'
  | 'sosis';

interface Props {
  kind: StickerKind;
  class?: string;
  style?: string;
  [attr: `data-${string}`]: string | boolean | undefined;
}
const { kind, class: className = '', style, ...attrs } = Astro.props;
const navy = '#1d3a6e';
---

<svg
  class:list={['sticker', className]}
  style={style}
  {...attrs}
  viewBox="0 0 100 100"
  aria-hidden="true"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    kind === 'dimsum' && (
      <g>
        <path d="M12 66c0-22 18-40 38-40s38 18 38 40c0 8-17 12-38 12S12 74 12 66Z" fill="#fbecd0" stroke="#c58e4e" stroke-width="4" />
        <path d="M36 32c2 8 2 14 0 22M50 27v26M64 32c-2 8-2 14 0 22" stroke="#d9a76a" stroke-width="3.5" />
        <path d="M50 22c-4-4-2-10 3-10" stroke="#6dbe6a" stroke-width="4" />
      </g>
    )
  }
  {
    kind === 'chopsticks' && (
      <g stroke-width="7">
        <path d="M14 88 78 10" stroke="#c8323c" />
        <path d="M30 92 90 20" stroke="#c8323c" />
        <path d="M14 88 28 71M30 92l13-16" stroke="#f3e2c4" />
      </g>
    )
  }
  {
    kind === 'kopi' && (
      <g>
        <path d="M60 4 52 30" stroke="#8a1c2b" stroke-width="5" />
        <path d="M24 26h52l-6 66H30Z" fill="#fff" stroke={navy} stroke-width="4" />
        <path d="M27 50h46l-4 40H31Z" fill="#a8693b" />
        <path d="M26 38h48l-1 12H27Z" fill="#f1dcc0" />
      </g>
    )
  }
  {
    kind === 'matcha' && (
      <g>
        <path d="M24 22h52l-6 70H30Z" fill="#fff" stroke={navy} stroke-width="4" />
        <path d="M26.5 40h47l-1.6 18H28.1Z" fill="#7cb342" />
        <path d="M28.1 58h43.8l-2.9 32H31Z" fill="#f4f1e6" />
        <rect x="36" y="64" width="12" height="12" rx="2" fill="#dfe9f5" stroke="#b6c7dd" stroke-width="2" />
      </g>
    )
  }
  {
    kind === 'egg' && (
      <g>
        <path d="M18 52c-6-20 12-36 30-34 10-12 34-6 34 12 14 8 10 34-6 38-6 16-34 18-44 6-14 0-20-10-14-22Z" fill="#fff" stroke={navy} stroke-width="4" />
        <circle cx="50" cy="52" r="15" fill="#f4b13e" />
        <circle cx="45" cy="47" r="4" fill="#fff" />
      </g>
    )
  }
  {
    kind === 'bowl' && (
      <g>
        <path d="M14 46c4-14 18-20 36-20s32 6 36 20Z" fill="#f2a54a" stroke={navy} stroke-width="4" />
        <path d="M58 6 46 44M72 10 56 46" stroke="#c8323c" stroke-width="5" />
        <path d="M10 46h80c-2 24-18 38-40 38S12 70 10 46Z" fill="#fff" stroke={navy} stroke-width="4" />
        <path d="M14 56h72" stroke="#c8323c" stroke-width="4" stroke-dasharray="6 5" />
      </g>
    )
  }
  {
    kind === 'esteh' && (
      <g>
        {/* Es teh plastik, tied with a rubber band */}
        <path d="M58 4 52 74" stroke="#c8323c" stroke-width="5" />
        <path d="M32 30h36c5 28 7 44-3 56-6 6-24 6-30 0-10-12-8-28-3-56Z" fill="#fdf6ea" stroke={navy} stroke-width="4" />
        <path d="M30.5 46h39c2.5 18 2 30-5.5 38-6 5-22 5-28 0-7.5-8-8-20-5.5-38Z" fill="#c8742f" />
        <rect x="36" y="52" width="12" height="12" rx="2.5" fill="#fff" opacity=".85" transform="rotate(-12 42 58)" />
        <rect x="52" y="62" width="11" height="11" rx="2.5" fill="#fff" opacity=".85" transform="rotate(10 57 67)" />
        <path d="M58 30 57 46" stroke="#c8323c" stroke-width="5" />
        <path d="M37 24h26" stroke="#f4b13e" stroke-width="6" />
        <path d="M40 24c-2-6 2-10 6-8M60 24c2-6-2-10-6-8" stroke={navy} stroke-width="3.5" />
      </g>
    )
  }
  {
    kind === 'gorengan' && (
      <g>
        {/* Bakwan with a cabe rawit on the side */}
        <path
          d="M14 54c-4-14 8-26 20-24 6-10 22-12 30-4 12-2 22 10 18 22 6 10-2 24-14 22-6 10-24 10-32 2-12 2-24-8-22-18Z"
          fill="#e5a548"
          stroke="#a86424"
          stroke-width="4"
        />
        <path d="M30 44l8 3M52 38l6 6M44 60l9-2M64 56l4 7" stroke="#e8692c" stroke-width="3.5" />
        <path d="M38 54l5-5M58 48l-2 7M26 58l6 1M72 46l-5 3" stroke="#6dbe6a" stroke-width="3.5" />
        <path d="M58 88c12 4 26-2 30-16 1-3-2-4-3-2-6 10-16 14-27 12-3 0-3 5 0 6Z" fill="#3fa34d" stroke="#1f6b2b" stroke-width="3" />
        <path d="M86 70c1-4 4-7 8-7" stroke="#1f6b2b" stroke-width="3.5" />
      </g>
    )
  }
  {
    kind === 'rotibakar' && (
      <g>
        {/* Roti bakar cokelat keju */}
        <path
          d="M18 42c-6-14 6-24 18-22 4-6 24-6 28 0 12-2 24 8 18 22v40c0 4-3 6-6 6H24c-3 0-6-2-6-6Z"
          fill="#c9864a"
          stroke={navy}
          stroke-width="4"
        />
        <path d="M26 46c-4-9 4-16 13-15 3-4 19-4 22 0 9-1 17 6 13 15v34H26Z" fill="#f3d39b" />
        <path d="M28 52c6 6 10-6 16 0s10-6 16 0 9-6 13 0" stroke="#5a3220" stroke-width="5" />
        <path d="M34 64l6 2M50 61l4 5M60 70l6-1M38 73l6 1" stroke="#f4b13e" stroke-width="3.5" />
      </g>
    )
  }
  {
    kind === 'pisang' && (
      <g>
        {/* Pisang goreng, two pieces */}
        <path d="M12 54c10-22 40-34 70-28 6 1 6 8 0 10-24 4-44 18-58 30-6 5-15-4-12-12Z" fill="#e9a640" stroke="#a86424" stroke-width="4" />
        <path d="M18 80c14-18 44-24 70-14 6 2 4 9-2 9-22-2-44 4-60 14-6 4-12-3-8-9Z" fill="#f0b552" stroke="#a86424" stroke-width="4" />
        <path d="M30 46l2 3M46 38l2 3M62 32l2 3M34 76l2 3M52 70l2 3M70 68l2 3" stroke="#a86424" stroke-width="3" />
      </g>
    )
  }
  {
    kind === 'kopisaset' && (
      <g>
        {/* A strip of kopi saset, like the ones hanging at the counter */}
        <circle cx="50" cy="8" r="3" stroke={navy} stroke-width="3" />
        <path d="M28 12h44v38H28Z" fill="#8a1c2b" stroke={navy} stroke-width="3.5" />
        <path d="M28 50h44v38H28Z" fill="#f1dcc0" stroke={navy} stroke-width="3.5" />
        <path d="M28 50h44" stroke="#fff" stroke-width="2" stroke-dasharray="3 3" />
        <circle cx="50" cy="31" r="10" fill="#f7d774" />
        <ellipse cx="50" cy="31" rx="4.5" ry="6.5" fill="#5a3220" transform="rotate(20 50 31)" />
        <path d="M48 26c3 3 3 7 0 10" stroke="#f7d774" stroke-width="1.8" />
        <path d="M40 62h20l-2 16H42Z" fill="#fff" stroke="#a8693b" stroke-width="3" />
        <path d="M42 66h16" stroke="#a8693b" stroke-width="5" />
        <path d="M60 66c5 0 5 7 0 7" stroke="#a8693b" stroke-width="2.5" />
      </g>
    )
  }
  {
    kind === 'kerupuk' && (
      <g>
        <path
          d="M81 50Q89.3 59 77.9 63.5Q81.5 75.1 69.3 74.2Q67.5 86.3 56.9 80.2Q50 90.3 43.1 80.2Q32.5 86.3 30.7 74.2Q18.5 75.1 22.1 63.5Q10.7 59 19 50Q10.7 41 22.1 36.5Q18.5 24.9 30.7 25.8Q32.5 13.7 43.1 19.8Q50 9.7 56.9 19.8Q67.5 13.7 69.3 25.8Q81.5 24.9 77.9 36.5Q89.3 41 81 50Z"
          fill="#fffaf0"
          stroke="#d8b878"
          stroke-width="4"
        />
        <path
          d="M50 50c4-2 7 4 2 7-6 4-14-2-11-9 4-10 18-10 23-1 7 11-2 26-15 26-16 1-26-14-21-28"
          stroke="#e7d2a4"
          stroke-width="3.5"
        />
      </g>
    )
  }
  {
    kind === 'mie' && (
      <g>
        {/* A block of instant noodles, fresh out of the pack */}
        <rect x="14" y="22" width="72" height="58" rx="12" fill="#f7d774" stroke="#c8962e" stroke-width="4" />
        <path d="M22 36c6-6 10 6 16 0s10 6 16 0 10 6 16 0 8 4 10 2" stroke="#dcae3c" stroke-width="3.5" />
        <path d="M22 50c6-6 10 6 16 0s10 6 16 0 10 6 16 0 8 4 10 2" stroke="#dcae3c" stroke-width="3.5" />
        <path d="M22 64c6-6 10 6 16 0s10 6 16 0 10 6 16 0 8 4 10 2" stroke="#dcae3c" stroke-width="3.5" />
        <path d="M62 70h26v20H62Z" fill="#c8323c" stroke={navy} stroke-width="3" transform="rotate(12 75 80)" />
        <path d="M66 76h16" stroke="#fff" stroke-width="2.5" transform="rotate(12 75 80)" />
      </g>
    )
  }
  {
    kind === 'sosis' && (
      <g>
        {/* Sosis bakar on a skewer */}
        <path d="M18 90 44 58" stroke="#c9864a" stroke-width="5" />
        <rect x="26" y="18" width="30" height="66" rx="15" fill="#d0533e" stroke={navy} stroke-width="4" transform="rotate(38 41 51)" />
        <path d="M36 40l14 6M30 52l14 6M42 28l14 6" stroke="#8a2a1e" stroke-width="3.5" transform="rotate(10 44 44)" />
        <path d="M40 36l2-6" stroke="#fff" stroke-width="3" opacity=".7" />
      </g>
    )
  }
</svg>
