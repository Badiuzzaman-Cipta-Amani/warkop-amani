---
import { Icon } from 'astro-icon/components';
import Sticker from './Sticker.astro';

const posts = [
  { id: 'DYmTQZZFC6H', label: 'Di balik layar dapur Warkop Amani' },
  { id: 'DYEvAemmYyW', label: 'Opening day Warkop Amani x Snap Z Photobox' },
  { id: 'DcpPUlbE_1f', label: 'Capek itu wajar, kok' },
];
---

<section id="daily" class="grid-paper relative py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="relative" data-pop>
        <Sticker kind="chopsticks" class="absolute -top-12 -left-4 w-14 -rotate-12" data-pop="spin" style="--d:300ms" />
        <h2 class="sticker-text text-[clamp(2.3rem,5.5vw,4rem)]">Daily warkop</h2>
        <p class="mt-3 max-w-lg text-lg text-ink/80">Intip dapur, menu baru, dan cerita-cerita kecil dari Instagram kami.</p>
      </div>
      <a href="https://www.instagram.com/warkopamani" target="_blank" rel="noopener" class="btn btn-ghost" data-pop style="--d:150ms">
        <Icon name="ri:instagram-line" class="h-5 w-5" aria-hidden="true" />
        Follow @warkopamani
      </a>
    </div>

    <div class="mt-12 grid justify-items-center gap-6 md:grid-cols-2 lg:grid-cols-3" data-ig-feed data-pop>
      {
        posts.map((p) => (
          <blockquote
            class="instagram-media !m-0 w-full !max-w-[400px] !min-w-0 overflow-hidden rounded-3xl bg-white"
            data-instgrm-permalink={`https://www.instagram.com/p/${p.id}/`}
            data-instgrm-version="14"
          >
            <a
              href={`https://www.instagram.com/p/${p.id}/`}
              target="_blank"
              rel="noopener"
              class="flex aspect-[4/5] flex-col items-center justify-center gap-3 p-6 text-center font-semibold text-navy"
            >
              <Icon name="ri:instagram-line" class="h-10 w-10 text-maroon" aria-hidden="true" />
              {p.label}
              <span class="text-sm text-ink/60">Lihat di Instagram</span>
            </a>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>

<script>
  // Load Instagram's embed script only when the feed is about to scroll into view.
  const feed = document.querySelector('[data-ig-feed]');
  if (feed) {
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        const s = document.createElement('script');
        s.src = 'https://www.instagram.com/embed.js';
        s.async = true;
        document.body.appendChild(s);
      },
      { rootMargin: '400px' },
    );
    io.observe(feed);
  }
</script>
