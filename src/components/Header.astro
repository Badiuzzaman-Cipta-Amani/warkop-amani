---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import { site } from '../data/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b-2 border-grid bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-2 sm:px-6">
    <Logo class="h-14 sm:h-16" />
    <nav aria-label="Navigasi utama" class="hidden md:block">
      <ul class="flex items-center gap-7 text-[0.95rem] font-semibold text-navy">
        {
          site.nav.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={l.href === path ? 'page' : undefined}
                class="underline-offset-[6px] decoration-2 decoration-maroon hover:underline aria-[current=page]:underline"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={site.whatsapp} target="_blank" rel="noopener" class="btn btn-primary !px-4 !py-2.5 text-sm">
      <Icon name="ri:whatsapp-line" class="h-5 w-5" aria-hidden="true" />
      <span>Chat <span class="hidden sm:inline">WhatsApp</span><span class="sm:hidden">WA</span></span>
    </a>
  </div>
</header>
