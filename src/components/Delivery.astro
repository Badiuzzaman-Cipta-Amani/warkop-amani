---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center gap-2', className]} aria-label="Pesan antar online">
  {
    site.delivery.map((d) => {
      const Tag = d.href ? 'a' : 'span';
      return (
        <li>
          <Tag
            href={d.href || undefined}
            target={d.href ? '_blank' : undefined}
            rel={d.href ? 'noopener' : undefined}
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-3.5 py-1.5 text-sm font-extrabold text-white shadow-[0_3px_0_rgb(0_0_0_/_0.2)]',
              d.href && 'transition-transform hover:-translate-y-0.5',
            ]}
            style={`background:${d.bg}`}
          >
            <Icon name="ri:e-bike-2-line" class="h-4 w-4" aria-hidden="true" />
            {d.label}
          </Tag>
        </li>
      );
    })
  }
</ul>
