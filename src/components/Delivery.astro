---
import { site } from '../data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center gap-3', className]} aria-label="Pesan antar online">
  {
    site.delivery.map((d) => (
      <li>
        <a href={d.href} target="_blank" rel="noopener" class="btn btn-ghost hover:-translate-y-0.5">
          <img src={d.logo} width={d.width} height={d.height} alt={d.label} class="h-6 w-auto" loading="lazy" />
        </a>
      </li>
    ))
  }
</ul>
